# Google Cloud OAuth 2.0 Web Client Credentials
# Configure these values in Google Cloud Console under APIs & Services -> Credentials -> OAuth Client ID (Web Application)

GOOGLE_CLIENT_ID="your_google_oauth_client_id_here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret_here"

# Gemini Enterprise Custom MCP Configuration Endpoints for Google-Managed BigQuery
BQ_MANAGED_MCP_SERVER_URL="https://bigquery.googleapis.com/mcp"
GOOGLE_OAUTH_AUTHORIZATION_URL="https://accounts.google.com/o/oauth2/v2/auth"
GOOGLE_OAUTH_TOKEN_URL="https://oauth2.googleapis.com/token"
