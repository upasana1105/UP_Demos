# Box Application OAuth 2.0 Credentials
# Configure these values in your Box Admin Console / Developer Console under Integration Credentials

BOX_CLIENT_ID="your_box_client_id_here"
BOX_CLIENT_SECRET="your_box_client_secret_here"

# Gemini Enterprise Custom MCP Configuration Endpoints
BOX_MCP_SERVER_URL="https://mcp.box.com"
BOX_OAUTH_AUTHORIZATION_URL="https://account.box.com/api/oauth2/authorize"
BOX_OAUTH_TOKEN_URL="https://api.box.com/oauth2/token"
