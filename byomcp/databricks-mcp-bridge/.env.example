# Databricks MCP Bridge Environment Configuration
# Copy this file to .env and replace placeholders with your real values

# Your Databricks Workspace Personal Access Token (PAT)
DATABRICKS_PAT=your_databricks_pat_here

# Your Databricks Workspace Host URL (e.g., https://dbc-xxxx.cloud.databricks.com)
DATABRICKS_WORKSPACE=https://dbc-6bcd4697-3ffd.cloud.databricks.com

# Server Port (Defaults to 8080 for Cloud Run compatibility)
PORT=8080
